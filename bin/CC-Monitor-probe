#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from cc_monitor.probe import run

if __name__ == "__main__":
    if os.name == "posix" and hasattr(os, "geteuid") and os.geteuid() != 0:
        print("[CC-Monitor] 系统层探针需要 root 权限 (bpftrace 需要), 请用 sudo 运行", file=sys.stderr)
        sys.exit(1)
    run()
